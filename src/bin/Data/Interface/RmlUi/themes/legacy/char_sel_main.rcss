/* Character-selection controls keep their original dimensions, anchors and click targets.
   Shared blank legacy button frames replace baked English labels so every locale can render
   its own text. Sizes remain in scene-bar rem units. */stretch-x utilities; CCharSelMainWin::ApplyLayout() still computes the legacy hit-test
   rects separately (CalculateLayout(), the original's layout). Sizes are the original's 800x600
   pixels in rem (char_sel_main.rml's body is "scene-bar-scale": 1rem = one of them scaled like the
   original, UI::Scaling::SceneBarScale(), RmlNativeText.h), measured from the original's anchor
   line at 567/600 of the window height, #panel's bottom. */

@spritesheet charsel-deco-sheet
{
	src: "../../../deco.tga";
	charsel-deco-image: 0px 0px 189px 103px;
}

/* Full-width positioning container, not a bar-shaped box -- every child anchors directly to its
   bottom edge (the original's anchor line) or a corner. */
#panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 94.5vh;
	pointer-events: none;
}

.btn-icon {
	position: absolute;
	width: 54rem;
	height: 30rem;
	bottom: 11rem;
	decorator: image(legacy-btn-idle);
	cursor: pointer;
	pointer-events: auto;
}
#btn_create { left: 22rem; }
#btn_menu   { left: 77rem; }
#btn_connect { right: 77rem; }
#btn_delete  { right: 22rem; }

.btn-icon.disabled {
	pointer-events: none;
	cursor: default;
}
.btn-icon:hover { decorator: image(legacy-btn-hover); }
.btn-icon:active { decorator: image(legacy-btn-active); }
.button-text {
	display: block;
	font-family: "token(font-body)";
	font-size: 12rem;
	line-height: 30rem;
	text-align: center;
	white-space: nowrap;
	color: token(text-primary);
	pointer-events: none;
}
.btn-icon.disabled .button-text { color: token(text-dim); }
.btn-icon-label {
	display: none;
}

/* modern-only caption below the button -- legacy has no text label here; left unstyled so it
   stays a zero-height pass-through. */
.btn-icon-caption {
	display: none;
}

/* Flat, semi-transparent backing strip behind the (rarely shown) account-block message. */
.info-bar {
	position: absolute;
	left: 133rem;
	right: 133rem;
	bottom: 15rem;
	height: 21rem;
	background-color: token(surface-overlay);
	pointer-events: none;
}

/* Decorative flourish over the Connect/Delete buttons' top-right corner -- paints behind them
   (declared first in char_sel_main.rml). */
.deco {
	position: absolute;
	width: 189rem;
	height: 103rem;
	right: 0rem;
	bottom: -3rem;
	pointer-events: none;
	decorator: image(charsel-deco-image);
}

/* Centered around a fixed screen X unrelated to this window's own position. */
#account_block_message {
	position: absolute;
	left: 0;
	top: 330rem;
	width: 640rem;
	pointer-events: none;
}
.line-row {
	line-height: 18rem;
	text-align: center;
}
.line {
	display: inline-block;
	color: #000000;
	background-color: rgba(255, 255, 0, 128);
	white-space: nowrap;
	padding: 0 2rem;
}
